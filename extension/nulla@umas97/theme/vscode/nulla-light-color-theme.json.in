{
  "//": "Generato dall'estensione GNOME Nulla (modello theme/vscode/nulla-light-color-theme.json.in): le modifiche manuali vengono sovrascritte.",
  "name": "Nulla Light",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#1d1d22",
    "descriptionForeground": "#6e6e77",
    "disabledForeground": "#a0a0a8",
    "errorForeground": "#c4383a",
    "icon.foreground": "#55555e",
    "focusBorder": "{{accent}}99",
    "contrastBorder": "#00000000",
    "selection.background": "{{accent}}66",
    "widget.border": "#0000000c",
    "widget.shadow": "#0000001f",
    "sash.hoverBorder": "{{accent}}",
    "textLink.foreground": "{{accent_strong}}",
    "textLink.activeForeground": "{{accent_strong}}",
    "progressBar.background": "{{accent}}",

    "titleBar.activeBackground": "#f2f2f5",
    "titleBar.inactiveBackground": "#f2f2f5",
    "titleBar.activeForeground": "#3a3a42",
    "titleBar.inactiveForeground": "#7c7c85",
    "titleBar.border": "#00000000",
    "commandCenter.background": "#00000006",
    "commandCenter.activeBackground": "#0000000c",
    "commandCenter.border": "#00000008",
    "commandCenter.foreground": "#55555e",

    "activityBar.background": "#f2f2f5",
    "activityBar.foreground": "#1d1d22",
    "activityBar.inactiveForeground": "#8a8a93",
    "activityBar.border": "#00000000",
    "activityBar.activeBorder": "{{accent}}",
    "activityBar.activeBackground": "#00000000",
    "activityBarBadge.background": "{{accent}}",
    "activityBarBadge.foreground": "{{accent_fg}}",
    "activityBarTop.foreground": "#1d1d22",
    "activityBarTop.activeBorder": "{{accent}}",
    "activityBarTop.inactiveForeground": "#8a8a93",

    "sideBar.background": "#f2f2f5",
    "sideBar.foreground": "#3c3c44",
    "sideBar.border": "#00000008",
    "sideBarTitle.foreground": "#6e6e77",
    "sideBarSectionHeader.background": "#00000000",
    "sideBarSectionHeader.foreground": "#6e6e77",
    "sideBarSectionHeader.border": "#00000000",

    "list.activeSelectionBackground": "#0000000c",
    "list.activeSelectionForeground": "#000000",
    "list.inactiveSelectionBackground": "#00000008",
    "list.hoverBackground": "#00000006",
    "list.focusOutline": "{{accent}}99",
    "list.focusAndSelectionOutline": "#00000000",
    "list.highlightForeground": "{{accent_strong}}",
    "list.dropBackground": "{{accent}}33",
    "tree.indentGuidesStroke": "#0000000c",

    "editorGroupHeader.tabsBackground": "#f2f2f5",
    "editorGroupHeader.tabsBorder": "#00000000",
    "editorGroupHeader.noTabsBackground": "#fafafb",
    "editorGroup.border": "#00000008",
    "editorGroup.dropBackground": "{{accent}}22",
    "tab.activeBackground": "#fafafb",
    "tab.activeForeground": "#1d1d22",
    "tab.activeBorder": "#00000000",
    "tab.activeBorderTop": "{{accent}}",
    "tab.inactiveBackground": "#f2f2f5",
    "tab.inactiveForeground": "#7c7c85",
    "tab.hoverBackground": "#ececf0",
    "tab.unfocusedActiveBorderTop": "#00000013",
    "tab.border": "#00000000",
    "tab.lastPinnedBorder": "#0000000c",
    "breadcrumb.background": "#fafafb",
    "breadcrumb.foreground": "#7c7c85",
    "breadcrumb.focusForeground": "#1d1d22",

    "editor.background": "#fafafb",
    "editor.foreground": "#24242a",
    "editorCursor.foreground": "{{accent_strong}}",
    "editor.lineHighlightBackground": "#00000004",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "{{accent}}4d",
    "editor.inactiveSelectionBackground": "{{accent}}26",
    "editor.selectionHighlightBackground": "#0000000c",
    "editor.wordHighlightBackground": "#0000000b",
    "editor.wordHighlightStrongBackground": "#00000010",
    "editor.findMatchBackground": "{{accent}}66",
    "editor.findMatchHighlightBackground": "{{accent}}33",
    "editor.rangeHighlightBackground": "#00000005",
    "editorLineNumber.foreground": "#b0b0b8",
    "editorLineNumber.activeForeground": "#55555e",
    "editorIndentGuide.background1": "#00000006",
    "editorIndentGuide.activeBackground1": "#00000017",
    "editorWhitespace.foreground": "#00000010",
    "editorRuler.foreground": "#00000008",
    "editorBracketMatch.background": "#0000000c",
    "editorBracketMatch.border": "#00000000",
    "editorGutter.background": "#fafafb",
    "editorOverviewRuler.border": "#00000000",
    "editorLink.activeForeground": "{{accent_strong}}",
    "editorStickyScroll.background": "#fafafb",
    "editorStickyScroll.shadow": "#0000001f",

    "editorWidget.background": "#ffffff",
    "editorWidget.border": "#0000000c",
    "editorSuggestWidget.background": "#ffffff",
    "editorSuggestWidget.border": "#0000000c",
    "editorSuggestWidget.selectedBackground": "#0000000c",
    "editorSuggestWidget.highlightForeground": "{{accent_strong}}",
    "editorHoverWidget.background": "#ffffff",
    "editorHoverWidget.border": "#0000000c",
    "peekView.border": "{{accent}}99",
    "peekViewEditor.background": "#f2f2f5",
    "peekViewResult.background": "#ececf0",
    "peekViewTitle.background": "#ececf0",

    "quickInput.background": "#ffffff",
    "quickInputTitle.background": "#ffffff",
    "quickInputList.focusBackground": "#0000000c",
    "pickerGroup.border": "#0000000c",
    "pickerGroup.foreground": "{{accent_strong}}",
    "menu.background": "#ffffff",
    "menu.foreground": "#1d1d22",
    "menu.selectionBackground": "#0000000c",
    "menu.selectionForeground": "#000000",
    "menu.separatorBackground": "#0000000c",
    "menu.border": "#0000000c",
    "menubar.selectionBackground": "#0000000c",

    "input.background": "#00000008",
    "input.border": "#00000008",
    "input.foreground": "#1d1d22",
    "input.placeholderForeground": "#8a8a93",
    "inputOption.activeBackground": "{{accent}}40",
    "inputOption.activeBorder": "#00000000",
    "dropdown.background": "#ffffff",
    "dropdown.border": "#0000000c",
    "checkbox.background": "#00000008",
    "checkbox.border": "#00000013",
    "button.background": "{{accent}}",
    "button.foreground": "{{accent_fg}}",
    "button.hoverBackground": "{{accent_strong}}",
    "button.border": "#00000000",
    "button.separator": "{{accent_fg}}66",
    "button.secondaryBackground": "#0000000c",
    "button.secondaryForeground": "#1d1d22",
    "button.secondaryHoverBackground": "#00000013",
    "badge.background": "{{accent}}",
    "badge.foreground": "{{accent_fg}}",

    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.background": "#0000000c",
    "scrollbarSlider.hoverBackground": "#00000016",
    "scrollbarSlider.activeBackground": "#0000001f",

    "panel.background": "#fafafb",
    "panel.border": "#00000008",
    "panelTitle.activeForeground": "#1d1d22",
    "panelTitle.inactiveForeground": "#7c7c85",
    "panelTitle.activeBorder": "{{accent}}",
    "terminal.background": "#fafafb",
    "terminal.foreground": "#24242a",
    "terminalCursor.foreground": "{{accent_strong}}",
    "terminal.selectionBackground": "{{accent}}4d",
    "terminal.ansiBlack": "#24242a",
    "terminal.ansiRed": "#c43c3c",
    "terminal.ansiGreen": "#3f8a2c",
    "terminal.ansiYellow": "#9a7400",
    "terminal.ansiBlue": "#2a6aa8",
    "terminal.ansiMagenta": "#8a46b5",
    "terminal.ansiCyan": "#16827a",
    "terminal.ansiWhite": "#8a8a93",
    "terminal.ansiBrightBlack": "#6e6e77",
    "terminal.ansiBrightRed": "#d65454",
    "terminal.ansiBrightGreen": "#4fa33a",
    "terminal.ansiBrightYellow": "#b58a00",
    "terminal.ansiBrightBlue": "#3c82c8",
    "terminal.ansiBrightMagenta": "#a35fcc",
    "terminal.ansiBrightCyan": "#1d9a90",
    "terminal.ansiBrightWhite": "#a0a0a8",

    "statusBar.background": "#f2f2f5",
    "statusBar.foreground": "#6e6e77",
    "statusBar.border": "#00000008",
    "statusBar.noFolderBackground": "#f2f2f5",
    "statusBar.debuggingBackground": "{{accent}}",
    "statusBar.debuggingForeground": "{{accent_fg}}",
    "statusBarItem.hoverBackground": "#0000000c",
    "statusBarItem.remoteBackground": "#00000000",
    "statusBarItem.remoteForeground": "{{accent_strong}}",
    "statusBarItem.prominentBackground": "#0000000c",

    "notifications.background": "#ffffff",
    "notifications.border": "#0000000c",
    "notificationCenterHeader.background": "#ffffff",
    "notificationToast.border": "#0000000c",
    "notificationLink.foreground": "{{accent_strong}}",

    "gitDecoration.modifiedResourceForeground": "#9a7400",
    "gitDecoration.untrackedResourceForeground": "#3f8a2c",
    "gitDecoration.addedResourceForeground": "#3f8a2c",
    "gitDecoration.deletedResourceForeground": "#c43c3c",
    "gitDecoration.ignoredResourceForeground": "#a0a0a8",
    "editorGutter.modifiedBackground": "#9a740099",
    "editorGutter.addedBackground": "#3f8a2c99",
    "editorGutter.deletedBackground": "#c43c3c99",
    "minimap.background": "#fafafb",
    "minimapSlider.background": "#00000008",
    "welcomePage.tileBackground": "#ececf0",
    "settings.headerForeground": "#1d1d22",
    "settings.modifiedItemIndicator": "{{accent}}",
    "keybindingLabel.background": "#00000008",
    "keybindingLabel.border": "#0000000c",
    "keybindingLabel.bottomBorder": "#0000000c"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#8e8e96", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new", "keyword.operator.expression"], "settings": { "foreground": "{{accent_strong}}" } },
    { "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "#6a6a73" } },
    { "scope": ["string", "punctuation.definition.string"], "settings": { "foreground": "#3f7d32" } },
    { "scope": ["string.regexp", "constant.character.escape"], "settings": { "foreground": "#a3427e" } },
    { "scope": ["constant.numeric", "constant.language", "constant.other", "support.constant"], "settings": { "foreground": "#a8640f" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#2a6aa8" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type", "entity.other.inherited-class"], "settings": { "foreground": "#167a6b" } },
    { "scope": ["variable", "meta.definition.variable"], "settings": { "foreground": "#24242a" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#6b5d43" } },
    { "scope": ["variable.language", "variable.language.this", "variable.language.self"], "settings": { "foreground": "{{accent_strong}}", "fontStyle": "italic" } },
    { "scope": ["variable.other.property", "support.variable.property", "meta.object-literal.key"], "settings": { "foreground": "#3c3c46" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#b33a3a" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#a8640f" } },
    { "scope": ["entity.name.section", "markup.heading"], "settings": { "foreground": "{{accent_strong}}", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#3f7d32" } },
    { "scope": ["markup.underline.link"], "settings": { "foreground": "{{accent_strong}}" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#3f8a2c" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#c43c3c" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#9a7400" } },
    { "scope": ["invalid"], "settings": { "foreground": "#c43c3c" } }
  ],
  "semanticTokenColors": {
    "parameter": "#6b5d43",
    "property": "#3c3c46",
    "enumMember": "#a8640f",
    "namespace": "#167a6b"
  }
}
