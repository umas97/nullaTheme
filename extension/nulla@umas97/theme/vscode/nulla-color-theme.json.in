{
  "//": "Generato dall'estensione GNOME Nulla (modello theme/vscode/nulla-color-theme.json.in): le modifiche manuali vengono sovrascritte.",
  "name": "Nulla",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#ebebed",
    "descriptionForeground": "#8b8b92",
    "disabledForeground": "#5c5c64",
    "errorForeground": "#f28b8b",
    "icon.foreground": "#b4b4bb",
    "focusBorder": "{{accent}}99",
    "contrastBorder": "#00000000",
    "selection.background": "{{accent}}66",
    "widget.border": "#ffffff14",
    "widget.shadow": "#00000066",
    "sash.hoverBorder": "{{accent}}",
    "textLink.foreground": "{{accent_text}}",
    "textLink.activeForeground": "{{accent_text}}",
    "progressBar.background": "{{accent}}",

    "titleBar.activeBackground": "#161619",
    "titleBar.inactiveBackground": "#161619",
    "titleBar.activeForeground": "#d6d6da",
    "titleBar.inactiveForeground": "#7a7a82",
    "titleBar.border": "#00000000",
    "commandCenter.background": "#ffffff0a",
    "commandCenter.activeBackground": "#ffffff14",
    "commandCenter.border": "#ffffff0d",
    "commandCenter.foreground": "#b4b4bb",

    "activityBar.background": "#161619",
    "activityBar.foreground": "#ebebed",
    "activityBar.inactiveForeground": "#6e6e76",
    "activityBar.border": "#00000000",
    "activityBar.activeBorder": "{{accent}}",
    "activityBar.activeBackground": "#00000000",
    "activityBarBadge.background": "{{accent}}",
    "activityBarBadge.foreground": "{{accent_fg}}",
    "activityBarTop.foreground": "#ebebed",
    "activityBarTop.activeBorder": "{{accent}}",
    "activityBarTop.inactiveForeground": "#6e6e76",

    "sideBar.background": "#161619",
    "sideBar.foreground": "#c8c8ce",
    "sideBar.border": "#ffffff0d",
    "sideBarTitle.foreground": "#8b8b92",
    "sideBarSectionHeader.background": "#00000000",
    "sideBarSectionHeader.foreground": "#8b8b92",
    "sideBarSectionHeader.border": "#00000000",

    "list.activeSelectionBackground": "#ffffff14",
    "list.activeSelectionForeground": "#ffffff",
    "list.inactiveSelectionBackground": "#ffffff0d",
    "list.hoverBackground": "#ffffff0a",
    "list.focusOutline": "{{accent}}99",
    "list.focusAndSelectionOutline": "#00000000",
    "list.highlightForeground": "{{accent_text}}",
    "list.dropBackground": "{{accent}}33",
    "tree.indentGuidesStroke": "#ffffff14",

    "editorGroupHeader.tabsBackground": "#161619",
    "editorGroupHeader.tabsBorder": "#00000000",
    "editorGroupHeader.noTabsBackground": "#121215",
    "editorGroup.border": "#ffffff0d",
    "editorGroup.dropBackground": "{{accent}}22",
    "tab.activeBackground": "#121215",
    "tab.activeForeground": "#ebebed",
    "tab.activeBorder": "#00000000",
    "tab.activeBorderTop": "{{accent}}",
    "tab.inactiveBackground": "#161619",
    "tab.inactiveForeground": "#7a7a82",
    "tab.hoverBackground": "#1b1b1f",
    "tab.unfocusedActiveBorderTop": "#ffffff1f",
    "tab.border": "#00000000",
    "tab.lastPinnedBorder": "#ffffff14",
    "breadcrumb.background": "#121215",
    "breadcrumb.foreground": "#7a7a82",
    "breadcrumb.focusForeground": "#ebebed",

    "editor.background": "#121215",
    "editor.foreground": "#e2e2e6",
    "editorCursor.foreground": "{{accent_text}}",
    "editor.lineHighlightBackground": "#ffffff06",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "{{accent}}4d",
    "editor.inactiveSelectionBackground": "{{accent}}26",
    "editor.selectionHighlightBackground": "#ffffff14",
    "editor.wordHighlightBackground": "#ffffff12",
    "editor.wordHighlightStrongBackground": "#ffffff1a",
    "editor.findMatchBackground": "{{accent}}66",
    "editor.findMatchHighlightBackground": "{{accent}}33",
    "editor.rangeHighlightBackground": "#ffffff08",
    "editorLineNumber.foreground": "#4e4e56",
    "editorLineNumber.activeForeground": "#b4b4bb",
    "editorIndentGuide.background1": "#ffffff0a",
    "editorIndentGuide.activeBackground1": "#ffffff26",
    "editorWhitespace.foreground": "#ffffff1a",
    "editorRuler.foreground": "#ffffff0d",
    "editorBracketMatch.background": "#ffffff14",
    "editorBracketMatch.border": "#00000000",
    "editorGutter.background": "#121215",
    "editorOverviewRuler.border": "#00000000",
    "editorLink.activeForeground": "{{accent_text}}",
    "editorStickyScroll.background": "#121215",
    "editorStickyScroll.shadow": "#00000066",

    "editorWidget.background": "#1e1e22",
    "editorWidget.border": "#ffffff14",
    "editorSuggestWidget.background": "#1e1e22",
    "editorSuggestWidget.border": "#ffffff14",
    "editorSuggestWidget.selectedBackground": "#ffffff14",
    "editorSuggestWidget.highlightForeground": "{{accent_text}}",
    "editorHoverWidget.background": "#1e1e22",
    "editorHoverWidget.border": "#ffffff14",
    "peekView.border": "{{accent}}99",
    "peekViewEditor.background": "#161619",
    "peekViewResult.background": "#1b1b1f",
    "peekViewTitle.background": "#1b1b1f",

    "quickInput.background": "#1e1e22",
    "quickInputTitle.background": "#1e1e22",
    "quickInputList.focusBackground": "#ffffff14",
    "pickerGroup.border": "#ffffff14",
    "pickerGroup.foreground": "{{accent_text}}",
    "menu.background": "#1e1e22",
    "menu.foreground": "#ebebed",
    "menu.selectionBackground": "#ffffff14",
    "menu.selectionForeground": "#ffffff",
    "menu.separatorBackground": "#ffffff14",
    "menu.border": "#ffffff14",
    "menubar.selectionBackground": "#ffffff14",

    "input.background": "#ffffff0d",
    "input.border": "#ffffff0d",
    "input.foreground": "#ebebed",
    "input.placeholderForeground": "#6e6e76",
    "inputOption.activeBackground": "{{accent}}40",
    "inputOption.activeBorder": "#00000000",
    "dropdown.background": "#1e1e22",
    "dropdown.border": "#ffffff14",
    "checkbox.background": "#ffffff0d",
    "checkbox.border": "#ffffff1f",
    "button.background": "{{accent}}",
    "button.foreground": "{{accent_fg}}",
    "button.hoverBackground": "{{accent_text}}",
    "button.border": "#00000000",
    "button.separator": "{{accent_fg}}66",
    "button.secondaryBackground": "#ffffff14",
    "button.secondaryForeground": "#ebebed",
    "button.secondaryHoverBackground": "#ffffff1f",
    "badge.background": "{{accent}}",
    "badge.foreground": "{{accent_fg}}",

    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.background": "#ffffff14",
    "scrollbarSlider.hoverBackground": "#ffffff24",
    "scrollbarSlider.activeBackground": "#ffffff33",

    "panel.background": "#121215",
    "panel.border": "#ffffff0d",
    "panelTitle.activeForeground": "#ebebed",
    "panelTitle.inactiveForeground": "#7a7a82",
    "panelTitle.activeBorder": "{{accent}}",
    "terminal.background": "#121215",
    "terminal.foreground": "#e2e2e6",
    "terminalCursor.foreground": "{{accent_text}}",
    "terminal.selectionBackground": "{{accent}}4d",
    "terminal.ansiBlack": "#2a2a30",
    "terminal.ansiRed": "#f07878",
    "terminal.ansiGreen": "#9fd28a",
    "terminal.ansiYellow": "#e8c46f",
    "terminal.ansiBlue": "#7cb2f0",
    "terminal.ansiMagenta": "#c79be8",
    "terminal.ansiCyan": "#74cfc4",
    "terminal.ansiWhite": "#d6d6da",
    "terminal.ansiBrightBlack": "#5c5c64",
    "terminal.ansiBrightRed": "#ff9a9a",
    "terminal.ansiBrightGreen": "#b8e6a4",
    "terminal.ansiBrightYellow": "#f5d896",
    "terminal.ansiBrightBlue": "#a2c9f7",
    "terminal.ansiBrightMagenta": "#dcbaf2",
    "terminal.ansiBrightCyan": "#9ae2d8",
    "terminal.ansiBrightWhite": "#ffffff",

    "statusBar.background": "#161619",
    "statusBar.foreground": "#8b8b92",
    "statusBar.border": "#ffffff0d",
    "statusBar.noFolderBackground": "#161619",
    "statusBar.debuggingBackground": "{{accent}}",
    "statusBar.debuggingForeground": "{{accent_fg}}",
    "statusBarItem.hoverBackground": "#ffffff14",
    "statusBarItem.remoteBackground": "#00000000",
    "statusBarItem.remoteForeground": "{{accent_text}}",
    "statusBarItem.prominentBackground": "#ffffff14",

    "notifications.background": "#1e1e22",
    "notifications.border": "#ffffff14",
    "notificationCenterHeader.background": "#1e1e22",
    "notificationToast.border": "#ffffff14",
    "notificationLink.foreground": "{{accent_text}}",

    "gitDecoration.modifiedResourceForeground": "#e8c46f",
    "gitDecoration.untrackedResourceForeground": "#9fd28a",
    "gitDecoration.addedResourceForeground": "#9fd28a",
    "gitDecoration.deletedResourceForeground": "#f07878",
    "gitDecoration.ignoredResourceForeground": "#5c5c64",
    "editorGutter.modifiedBackground": "#e8c46f99",
    "editorGutter.addedBackground": "#9fd28a99",
    "editorGutter.deletedBackground": "#f0787899",
    "minimap.background": "#121215",
    "minimapSlider.background": "#ffffff0d",
    "welcomePage.tileBackground": "#1b1b1f",
    "settings.headerForeground": "#ebebed",
    "settings.modifiedItemIndicator": "{{accent}}",
    "keybindingLabel.background": "#ffffff0d",
    "keybindingLabel.border": "#ffffff14",
    "keybindingLabel.bottomBorder": "#ffffff14"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#686870", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new", "keyword.operator.expression"], "settings": { "foreground": "{{accent_text}}" } },
    { "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "#9a9aa2" } },
    { "scope": ["string", "punctuation.definition.string"], "settings": { "foreground": "#a8d49a" } },
    { "scope": ["string.regexp", "constant.character.escape"], "settings": { "foreground": "#e3a6cf" } },
    { "scope": ["constant.numeric", "constant.language", "constant.other", "support.constant"], "settings": { "foreground": "#e8b77d" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#8cc2ea" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type", "entity.other.inherited-class"], "settings": { "foreground": "#7fd1c0" } },
    { "scope": ["variable", "meta.definition.variable"], "settings": { "foreground": "#e2e2e6" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#d6d0c4" } },
    { "scope": ["variable.language", "variable.language.this", "variable.language.self"], "settings": { "foreground": "{{accent_text}}", "fontStyle": "italic" } },
    { "scope": ["variable.other.property", "support.variable.property", "meta.object-literal.key"], "settings": { "foreground": "#c8c8d0" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#ec8f8f" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#e8b77d" } },
    { "scope": ["entity.name.section", "markup.heading"], "settings": { "foreground": "{{accent_text}}", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#a8d49a" } },
    { "scope": ["markup.underline.link"], "settings": { "foreground": "{{accent_text}}" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#9fd28a" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#f07878" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#e8c46f" } },
    { "scope": ["invalid"], "settings": { "foreground": "#f07878" } }
  ],
  "semanticTokenColors": {
    "parameter": "#d6d0c4",
    "property": "#c8c8d0",
    "enumMember": "#e8b77d",
    "namespace": "#7fd1c0"
  }
}
